# Where a printed transfer form's QR code should send a phone. Set this to the
# deployed address, or a sheet printed from a laptop will point at localhost.
VITE_APP_URL=https://your-asset-register.example.com

# Browser-safe Supabase configuration exposed by Vite.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend-only Supabase configuration.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Keep this secret on the server. Never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
